{
  "name": "AGH Logic Unit - PCB UDE",
  "image": "ghcr.io/agh-logic-unit/alu-pcb:latest",
  "imagePullPolicy": "always",
  "initializeCommand": "docker pull ghcr.io/agh-logic-unit/alu-pcb:latest || true",
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh-host,type=bind,readonly"
  ],
  "containerEnv": {
    "PATH": "/opt/alu-venv/bin:/usr/local/bin:/usr/bin:/bin"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/alu-venv/bin/python3",
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-python.python",
        "tamasfe.even-better-toml",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "mkdir -p ~/.ssh && (cp -rf ~/.ssh-host/* ~/.ssh/ 2>/dev/null || true) && chmod 700 ~/.ssh 2>/dev/null && chmod 600 ~/.ssh/* 2>/dev/null || true; kicad-cli --version && kikit --version"
}

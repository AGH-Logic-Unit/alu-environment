{
  "name": "AGH Logic Unit - Digital UDE",
  "image": "ghcr.io/agh-logic-unit/alu-rtl:latest",
  "imagePullPolicy": "always",
  "initializeCommand": "docker pull ghcr.io/agh-logic-unit/alu-rtl:latest || true",
  "remoteUser": "vscode",
  "mounts": [
    "source=alu-ccache-vol,target=/home/vscode/.cache/ccache,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly,consistency=cached"
  ],
  "containerEnv": {
    "CCACHE_DIR": "/home/vscode/.cache/ccache",
    "VERILATOR_CCACHE": "1",
    "PATH": "/opt/alu-venv/bin:/usr/local/bin:/usr/bin:/bin"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.associations": {
          "*.sv": "systemverilog",
          "*.svh": "systemverilog",
          "*.v": "verilog",
          "*.vh": "verilog"
        },
        "python.defaultInterpreterPath": "/opt/alu-venv/bin/python3",
        "editor.formatOnSave": true,
        "editor.rulers": [100, 120],

        "systemverilog.compilerType": "slang",
        "systemverilog.slang.launchPath": "/usr/local/bin/slang",

        "verilog.formatting.verilogHDL.formatter": "verible-verilog-format",
        "verilog.formatting.veribleVerilogFormatter.path": "/usr/local/bin/verible-verilog-format",
        "verilog.formatting.veribleVerilogFormatter.arguments": "--flagfile=.rules.verible_format",

        "[systemverilog]": {
          "editor.defaultFormatter": "mshr-h.veriloghdl",
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        },
        "[verilog]": {
          "editor.defaultFormatter": "mshr-h.veriloghdl",
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      },
      "extensions": [
        "MikePopoloski.slang",
        "mshr-h.veriloghdl",
        "surfer-project.surfer",
        "charliermarsh.ruff",
        "ms-python.python",
        "llvm-vs-code-extensions.vscode-clangd",
        "tamasfe.even-better-toml",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "just --version"
}
